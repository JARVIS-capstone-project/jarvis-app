# Backend that the Vite dev proxy forwards /api/* to (platform-system).
# Override per-developer in a local .env (gitignored).
VITE_API_TARGET=http://localhost:8080

# Base path the frontend uses for platform API calls.
# Keep this as /api so the dev proxy intercepts and forwards it.
VITE_API_BASE_URL=/api

# Backend that the Vite dev proxy forwards /agent/* to (agent-system).
# The proxy strips the /agent prefix before forwarding (agent-system's
# FastAPI mounts routers at /sessions, not /agent/sessions).
VITE_AGENT_TARGET=http://localhost:8000

# ── Vercel / static-CDN hosting only ──────────────────────────────────────
# Absolute origin of agent-system, e.g. https://agent.example.com
# Leave UNSET for local dev, the nginx image, or a GCP LB — those route
# /agent/* server-side and the default relative '/agent' is correct.
#
# NO '/agent' suffix and no trailing slash: agent-system mounts its routers
# at /sessions, and the /agent prefix exists only for a proxy to match on.
# Setting this makes agent calls cross-origin, which needs
# CORS_ALLOW_ORIGINS=<this frontend's origin> on agent-system. See vercel.md.
# VITE_AGENT_BASE_URL=

# Platform API stays RELATIVE even on Vercel — vercel.json rewrites /api/* to
# platform, so the browser sees one origin and the httpOnly refresh cookie
# (SameSite=Strict, path=/api/auth) keeps working. An absolute value here
# would force SameSite=None, which platform's RefreshCookieService forbids.
