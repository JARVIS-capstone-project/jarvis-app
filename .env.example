# Backend that the Vite dev proxy forwards /api/* to (platform-system).
# Override per-developer in a local .env (gitignored).
VITE_API_TARGET=http://localhost:8080

# Base path the frontend uses for platform API calls.
# Keep this as /api so the dev proxy intercepts and forwards it.
VITE_API_BASE_URL=/api

# Backend that the Vite dev proxy forwards /agent/* to (agent-system).
# The proxy strips the /agent prefix before forwarding (agent-system's
# FastAPI mounts routers at /sessions, not /agent/sessions).
VITE_AGENT_TARGET=http://localhost:8000

# ---------------------------------------------------------------------------
# MCP provider presets (Jira / Slack / Notion)
# ---------------------------------------------------------------------------
# agent-system reads an OAuth app's credentials from the request body, not
# from its own environment, so the browser has to carry them. Every value
# below is inlined into the JS bundle at build time and is readable by
# anyone who opens devtools — this is NOT a place for the credentials of an
# OAuth app you care about.
#
# Register the app first, and set its Redirect URL to exactly:
#     <agent-system OAUTH_REDIRECT_BASE>/mcp/oauth/callback
# A mismatch is rejected at the provider's consent screen, before any of
# this code runs.
#
# A provider missing any of its three values renders as "Not configured" in
# Browse and cannot be connected. That is the intended state until its app
# exists, not a bug.

# Atlassian's hosted endpoint speaks SSE: https://mcp.atlassian.com/v1/sse
VITE_JIRA_CLIENT_ID=
VITE_JIRA_CLIENT_SECRET=
VITE_JIRA_MCP_SERVER_URL=

# Slack ships no hosted MCP server — point this at a self-hosted one.
VITE_SLACK_CLIENT_ID=
VITE_SLACK_CLIENT_SECRET=
VITE_SLACK_MCP_SERVER_URL=

# Notion's hosted endpoint: https://mcp.notion.com/mcp
VITE_NOTION_CLIENT_ID=
VITE_NOTION_CLIENT_SECRET=
VITE_NOTION_MCP_SERVER_URL=
